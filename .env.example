# Copy to .env for `netlify dev`, and set the same keys in Netlify site settings.

# Supabase (US East). SUPABASE_KEY must be the service_role key — functions are
# the only thing that talks to Postgres, and RLS is enabled with no policies.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# Signing key for the app's own JWTs. Generate: openssl rand -base64 48
JWT_SECRET=

# Public site origin, used for the CORS allow-list (e.g. https://revertoapp.com)
SITE_URL=

# Azure Document Intelligence (invoice OCR)
AZURE_DI_ENDPOINT=https://xxxxxxxx.cognitiveservices.azure.com
AZURE_DI_KEY=

# USDA AMS Market News — free key from mymarketnews.ams.usda.gov
USDA_API_KEY=

# Shared secret for GitHub Actions cron calls. Generate: openssl rand -hex 32
CRON_SECRET=
